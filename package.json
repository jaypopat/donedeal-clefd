{
  "name": "tyrekick",
  "description": "Price and warning signals on DoneDeal car listings",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit && tsc --noEmit -p server",
    "test": "bun test",
    "worker:dev": "bun scripts/dev-worker.ts",
    "worker:smoke": "bun scripts/smoke-worker.ts",
    "verify:browser": "node scripts/verify-browser.cjs",
    "worker:check": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config server/wrangler.jsonc --outdir .output/worker",
    "check": "bun run compile && bun test && bun run build && bun run worker:check",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "happy-dom": "^21.0.3",
    "playwright-core": "1.58.2",
    "typescript": "^5.9.3",
    "web-ext": "^10.5.0",
    "wrangler": "^4.151.3",
    "wxt": "^0.21.3"
  }
}
